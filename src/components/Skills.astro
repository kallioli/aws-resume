---
import Section from './Section.astro';
import Meter from './Meter.astro';
import type { Resume } from '../lib/schema';
import { t } from '../i18n';

interface Props {
  groups: NonNullable<Resume['skills']>;
}
const { groups } = Astro.props;
---

<Section id="skills" title={t.sections.skills}>
  {
    groups.map((group) => (
      <div class="skill-group">
        <h3 class="skill-group__title">{group.name}</h3>
        <ul class="skills">
          {group.items.map((s) => (
            <li class="skill">
              <span class="skill__name">{s.name}</span>
              {s.level !== undefined && <Meter value={s.level} label={t.level(s.level)} />}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</Section>
