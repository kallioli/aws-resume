---
import Section from './Section.astro';
import Tags from './Tags.astro';
import Icon from './Icon.astro';
import type { Experience } from '../lib/schema';
import { duration, formatDate } from '../lib/format';
import { lang, t } from '../i18n';

interface Props {
  items: Experience[];
}
const { items } = Astro.props;
---

<Section id="experiences" title={t.sections.experiences} count={items.length}>
  <ol class="timeline">
    {
      items.map((job) => {
        const length = duration(job.start, job.end, { year: t.years, month: t.months });
        return (
          <li class="timeline__item">
            <article class="entry">
              <header class="entry__header">
                <h3 class="entry__title">{job.role}</h3>
                <p class="entry__org">
                  {job.companyUrl ? (
                    <a href={job.companyUrl} rel="noopener" target="_blank">
                      {job.company}
                      <span class="visually-hidden"> {t.opensInNewTab}</span>
                    </a>
                  ) : (
                    job.company
                  )}
                  {job.type && <span class="entry__type"> · {job.type}</span>}
                </p>
                <p class="entry__meta">
                  <span class="with-icon">
                    <Icon name="briefcase" size={14} />
                    <span>
                      <time datetime={job.start}>{formatDate(job.start, lang)}</time>
                      {' – '}
                      {job.end ? <time datetime={job.end}>{formatDate(job.end, lang)}</time> : <span>{t.present}</span>}
                      {length && <span class="muted"> · {length}</span>}
                    </span>
                  </span>
                  {job.location && (
                    <span class="with-icon">
                      <Icon name="map-pin" size={14} />
                      {job.location}
                    </span>
                  )}
                </p>
              </header>
              {job.summary && <p class="entry__summary">{job.summary}</p>}
              {job.highlights.length > 0 && (
                <ul class="entry__highlights">
                  {job.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
              <Tags items={job.tags} />
            </article>
          </li>
        );
      })
    }
  </ol>
</Section>
