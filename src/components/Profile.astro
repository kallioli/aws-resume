---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
import type { Resume, Profile as ProfileLink } from '../lib/schema';
import { assetUrl, initials, prettyUrl } from '../lib/format';
import { t } from '../i18n';

interface Props {
  basics: Resume['basics'];
}
const { basics } = Astro.props;
const base = import.meta.env.BASE_URL;

const networkIcon: Record<ProfileLink['network'], IconName> = {
  github: 'github',
  gitlab: 'gitlab',
  linkedin: 'linkedin',
  x: 'x',
  mastodon: 'mastodon',
  bluesky: 'bluesky',
  credly: 'badge-check',
  website: 'globe',
  blog: 'globe',
  other: 'link',
};

interface Contact {
  icon: IconName;
  label: string;
  value: string;
  href?: string;
  external?: boolean;
}

const networkName: Record<ProfileLink['network'], string> = {
  github: 'GitHub',
  gitlab: 'GitLab',
  linkedin: 'LinkedIn',
  x: 'X',
  mastodon: 'Mastodon',
  bluesky: 'Bluesky',
  credly: 'Credly',
  website: t.website,
  blog: 'Blog',
  other: 'Link',
};

const contacts: Contact[] = [];
if (basics.email) contacts.push({ icon: 'mail', label: t.email, value: basics.email, href: `mailto:${basics.email}` });
if (basics.phone)
  contacts.push({ icon: 'phone', label: t.phone, value: basics.phone, href: `tel:${basics.phone.replace(/[^+\d]/g, '')}` });
if (basics.website)
  contacts.push({ icon: 'globe', label: t.website, value: prettyUrl(basics.website), href: basics.website, external: true });
for (const p of basics.profiles) {
  contacts.push({
    icon: networkIcon[p.network],
    label: networkName[p.network],
    value: p.label ?? prettyUrl(p.url),
    href: p.url,
    external: true,
  });
}

const paragraphs = basics.summary?.split(/\n\s*\n/).map((p) => p.replace(/\s*\n\s*/g, ' ').trim()) ?? [];
---

<section class="card profile" aria-labelledby="profile-name">
  <div class="profile__head">
    {
      basics.photo ? (
        <img
          class="profile__photo"
          src={assetUrl(basics.photo, base)}
          alt={basics.photoAlt ?? basics.name}
          width="112"
          height="112"
          decoding="async"
        />
      ) : (
        <span class="profile__photo profile__photo--initials" aria-hidden="true">
          {initials(basics.name)}
        </span>
      )
    }
    <div class="profile__id">
      <h1 id="profile-name" class="profile__name">{basics.name}</h1>
      <p class="profile__title">{basics.title}</p>
      <p class="profile__meta">
        {
          basics.location && (
            <span class="with-icon">
              <Icon name="map-pin" size={16} />
              {basics.location}
            </span>
          )
        }
        {
          basics.availability && (
            <span class="status status--ok">
              <span class="status__dot" aria-hidden="true" />
              {basics.availability}
            </span>
          )
        }
      </p>
    </div>
  </div>

  {
    paragraphs.length > 0 && (
      <div class="profile__summary">
        <h2 class="visually-hidden">{t.sections.summary}</h2>
        {paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    )
  }

  {
    contacts.length > 0 && (
      <div class="profile__contacts">
        <h2 class="visually-hidden">{t.sections.contact}</h2>
        <dl class="kv">
          {contacts.map((c) => (
            <div class="kv__item">
              <dt class="kv__key">
                <Icon name={c.icon} size={16} />
                {c.label}
              </dt>
              <dd class="kv__value">
                {c.href ? (
                  <a href={c.href} {...(c.external ? { rel: 'me noopener', target: '_blank' } : {})}>
                    {c.value}
                    {c.external && <span class="visually-hidden"> {t.opensInNewTab}</span>}
                  </a>
                ) : (
                  c.value
                )}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }
</section>
