---
import Section from './Section.astro';
import Meter from './Meter.astro';
import type { Resume } from '../lib/schema';
import { t } from '../i18n';

interface Props {
  items: NonNullable<Resume['languages']>;
}
const { items } = Astro.props;
---

<Section id="languages" title={t.sections.languages}>
  <ul class="skills">
    {
      items.map((l) => (
        <li class="skill">
          <span class="skill__name">
            {l.name}
            {l.fluency && <span class="skill__note">{l.fluency}</span>}
          </span>
          {l.level !== undefined && <Meter value={l.level} label={t.level(l.level)} />}
        </li>
      ))
    }
  </ul>
</Section>
