---
/** Console-style container: a card with a header bar and an optional item count. */
interface Props {
  id: string;
  title: string;
  count?: number | undefined;
  class?: string;
}
const { id, title, count, class: className } = Astro.props;
const headingId = `${id}-title`;
---

<section id={id} class:list={['card', className]} aria-labelledby={headingId}>
  <header class="card__header">
    <h2 id={headingId} class="card__title">
      {title}
      {count !== undefined && <span class="card__count">({count})</span>}
    </h2>
    <slot name="actions" />
  </header>
  <div class="card__body">
    <slot />
  </div>
</section>
