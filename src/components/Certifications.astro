---
import Section from './Section.astro';
import Icon from './Icon.astro';
import type { Certification } from '../lib/schema';
import { assetUrl, formatDate, isExpired } from '../lib/format';
import { lang, t } from '../i18n';
import { brand } from 'virtual:cloud-resume/build';
import { brandInfo } from '../brands';

interface Props {
  items: Certification[];
}
const { items } = Astro.props;
const base = import.meta.env.BASE_URL;
const placeholder = assetUrl(brandInfo[brand].badgePlaceholder, base);

// Active certifications first, then most recent.
const sorted = [...items].sort(
  (a, b) => Number(isExpired(a.expires)) - Number(isExpired(b.expires)) || b.issued.localeCompare(a.issued),
);
---

<Section id="certifications" title={t.sections.certifications} count={items.length}>
  <ul class="certs">
    {
      sorted.map((cert) => {
        const expired = isExpired(cert.expires);
        return (
          <li class:list={['cert', { 'is-expired': expired }]}>
            <img
              class="cert__badge"
              src={cert.badge ? assetUrl(cert.badge, base) : placeholder}
              alt={t.badgeAlt(cert.name)}
              width="72"
              height="72"
              decoding="async"
              referrerpolicy="no-referrer"
            />
            <div class="cert__body">
              <h3 class="cert__name">{cert.name}</h3>
              <p class="cert__issuer">{cert.issuer}</p>
              <p class:list={['status', expired ? 'status--off' : 'status--ok']}>
                <span class="status__dot" aria-hidden="true" />
                {expired ? t.expired : t.active}
              </p>
              <dl class="cert__facts">
                <div>
                  <dt>{t.issued}</dt>
                  <dd>
                    <time datetime={cert.issued}>{formatDate(cert.issued, lang)}</time>
                  </dd>
                </div>
                <div>
                  <dt>{t.expires}</dt>
                  <dd>{cert.expires ? <time datetime={cert.expires}>{formatDate(cert.expires, lang)}</time> : t.noExpiry}</dd>
                </div>
                {cert.credentialId && (
                  <div class="cert__id">
                    <dt>{t.credentialId}</dt>
                    <dd>
                      <code>{cert.credentialId}</code>
                    </dd>
                  </div>
                )}
              </dl>
              {cert.url && (
                <a class="cert__verify" href={cert.url} rel="noopener" target="_blank" aria-label={t.verifyLabel(cert.name)}>
                  {t.verify}
                  <Icon name="external-link" size={14} />
                </a>
              )}
            </div>
          </li>
        );
      })
    }
  </ul>
</Section>
