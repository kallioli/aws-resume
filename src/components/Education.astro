---
import Section from './Section.astro';
import Icon from './Icon.astro';
import type { Resume } from '../lib/schema';
import { formatDate } from '../lib/format';
import { lang, t } from '../i18n';

interface Props {
  items: NonNullable<Resume['education']>;
}
const { items } = Astro.props;
---

<Section id="education" title={t.sections.education} count={items.length}>
  <ul class="list">
    {
      items.map((e) => (
        <li class="entry">
          <h3 class="entry__title">
            {e.degree}
            {e.field && <span>, {e.field}</span>}
          </h3>
          <p class="entry__org">
            {e.url ? (
              <a href={e.url} rel="noopener" target="_blank">
                {e.institution}
                <span class="visually-hidden"> {t.opensInNewTab}</span>
              </a>
            ) : (
              e.institution
            )}
          </p>
          {(e.start || e.end || e.location) && (
            <p class="entry__meta">
              {(e.start || e.end) && (
                <span class="with-icon">
                  <Icon name="graduation-cap" size={14} />
                  <span>
                    {e.start && <time datetime={e.start}>{formatDate(e.start, lang)}</time>}
                    {e.start && e.end && ' – '}
                    {e.end && <time datetime={e.end}>{formatDate(e.end, lang)}</time>}
                  </span>
                </span>
              )}
              {e.location && (
                <span class="with-icon">
                  <Icon name="map-pin" size={14} />
                  {e.location}
                </span>
              )}
            </p>
          )}
          {e.details && <p class="entry__summary">{e.details}</p>}
        </li>
      ))
    }
  </ul>
</Section>
