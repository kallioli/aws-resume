---
import Section from './Section.astro';
import Tags from './Tags.astro';
import Icon from './Icon.astro';
import type { Resume } from '../lib/schema';
import { prettyUrl } from '../lib/format';
import { t } from '../i18n';

interface Props {
  items: NonNullable<Resume['projects']>;
}
const { items } = Astro.props;
---

<Section id="projects" title={t.sections.projects} count={items.length}>
  <ul class="list">
    {
      items.map((p) => (
        <li class="entry">
          <h3 class="entry__title">
            {p.url ? (
              <a href={p.url} rel="noopener" target="_blank">
                {p.name}
                <span class="visually-hidden"> {t.opensInNewTab}</span>
              </a>
            ) : (
              p.name
            )}
          </h3>
          <p class="entry__summary">{p.description}</p>
          {p.repo && (
            <p class="entry__meta">
              <a class="with-icon" href={p.repo} rel="noopener" target="_blank">
                <Icon name="folder-git-2" size={14} />
                {t.source}: {prettyUrl(p.repo)}
              </a>
            </p>
          )}
          <Tags items={p.tags} />
        </li>
      ))
    }
  </ul>
</Section>
