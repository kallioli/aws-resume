---
import Icon from './Icon.astro';
import { t } from '../i18n';
---

<!--
  Cycles System -> Light -> Dark. Hidden until the script below runs, so
  visitors without JavaScript simply get their OS preference.
-->
<button
  type="button"
  class="btn btn--icon theme-toggle"
  id="theme-toggle"
  hidden
  data-label-system={t.theme.system}
  data-label-light={t.theme.light}
  data-label-dark={t.theme.dark}
  data-label-prefix={t.theme.label}
  aria-label={`${t.theme.label}: ${t.theme.system}`}
  title={`${t.theme.label}: ${t.theme.system}`}
>
  <span class="theme-toggle__icon" data-for="system"><Icon name="monitor" /></span>
  <span class="theme-toggle__icon" data-for="light"><Icon name="sun" /></span>
  <span class="theme-toggle__icon" data-for="dark"><Icon name="moon" /></span>
</button>

<script is:inline>
  (function () {
    var KEY = 'aws-resume-theme';
    var root = document.documentElement;
    var button = document.getElementById('theme-toggle');
    if (!button) return;
    var order = ['system', 'light', 'dark'];
    function current() {
      return root.getAttribute('data-theme-choice') || 'system';
    }
    function apply(choice) {
      root.setAttribute('data-theme-choice', choice);
      if (choice === 'system') root.removeAttribute('data-theme');
      else root.setAttribute('data-theme', choice);
      var text = button.getAttribute('data-label-prefix') + ': ' + button.getAttribute('data-label-' + choice);
      button.setAttribute('aria-label', text);
      button.setAttribute('title', text);
    }
    apply(current());
    button.hidden = false;
    button.addEventListener('click', function () {
      var next = order[(order.indexOf(current()) + 1) % order.length];
      apply(next);
      try {
        localStorage.setItem(KEY, next);
      } catch (e) {
        /* storage unavailable (private mode, blocked cookies): keep the choice for this page view */
      }
    });
  })();
</script>
