---
import Section from './Section.astro';
import type { Resume } from '../lib/schema';
import { t } from '../i18n';

interface Props {
  items: NonNullable<Resume['interests']>;
}
const { items } = Astro.props;
---

<Section id="interests" title={t.sections.interests}>
  <ul class="tags tags--loose">
    {
      items.map((i) => (
        <li class="tag">
          {i.url ? (
            <a href={i.url} rel="noopener" target="_blank">
              {i.name}
              <span class="visually-hidden"> {t.opensInNewTab}</span>
            </a>
          ) : (
            i.name
          )}
        </li>
      ))
    }
  </ul>
</Section>
