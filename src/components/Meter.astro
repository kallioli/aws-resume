---
/** 5-step level indicator. The value is exposed as text for screen readers. */
interface Props {
  value: number;
  label: string;
}
const { value, label } = Astro.props;
---

<span class="meter" role="img" aria-label={label}>
  {[1, 2, 3, 4, 5].map((step) => <span class:list={['meter__step', { 'is-on': step <= value }]} />)}
</span>
