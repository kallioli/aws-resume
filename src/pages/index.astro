---
import Base from '../layouts/Base.astro';
import Profile from '../components/Profile.astro';
import Experiences from '../components/Experiences.astro';
import Certifications from '../components/Certifications.astro';
import Projects from '../components/Projects.astro';
import Education from '../components/Education.astro';
import Skills from '../components/Skills.astro';
import Languages from '../components/Languages.astro';
import Interests from '../components/Interests.astro';
import config from '../config';
import { resume } from '../lib/resume';
import { personJsonLd } from '../lib/jsonld';

const { basics } = resume;
const description =
  config.description ?? basics.summary?.replace(/\s+/g, ' ').trim().slice(0, 160) ?? `${basics.name}, ${basics.title}`;
const jsonLd = personJsonLd(resume, Astro.site, import.meta.env.BASE_URL);

const has = <T,>(list: T[] | undefined): list is T[] => Array.isArray(list) && list.length > 0;
const sidebar = config.sidebar.filter((id) => (resume[id]?.length ?? 0) > 0);
---

<Base title={`${basics.name} – ${basics.title}`} description={description} jsonLd={jsonLd}>
  <Profile basics={basics} />

  <div class:list={['layout', { 'layout--single': sidebar.length === 0 }]}>
    <div class="layout__main">
      {
        config.sections.map((id) => {
          if (id === 'experiences' && has(resume.experiences)) return <Experiences items={resume.experiences} />;
          if (id === 'certifications' && has(resume.certifications))
            return <Certifications items={resume.certifications} />;
          if (id === 'projects' && has(resume.projects)) return <Projects items={resume.projects} />;
          if (id === 'education' && has(resume.education)) return <Education items={resume.education} />;
          return null;
        })
      }
    </div>
    {
      sidebar.length > 0 && (
        <aside class="layout__side">
          {sidebar.map((id) => {
            if (id === 'skills' && has(resume.skills)) return <Skills groups={resume.skills} />;
            if (id === 'languages' && has(resume.languages)) return <Languages items={resume.languages} />;
            if (id === 'interests' && has(resume.interests)) return <Interests items={resume.interests} />;
            return null;
          })}
        </aside>
      )
    }
  </div>
</Base>
