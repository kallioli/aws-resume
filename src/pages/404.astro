---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';
---

<Base title={t.notFoundTitle} noindex>
  <section class="card notfound" aria-labelledby="nf-title">
    <p class="notfound__code">404</p>
    <h1 id="nf-title">{t.notFoundTitle}</h1>
    <p>{t.notFoundText}</p>
    <p><a class="btn btn--primary" href={import.meta.env.BASE_URL}>{t.backHome}</a></p>
  </section>
</Base>
